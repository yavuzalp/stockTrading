# ── Alpaca ─────────────────────────────────────────────────────────────────────
ALPACA_PAPER_API_KEY=your_paper_api_key_here
ALPACA_PAPER_SECRET_KEY=your_paper_secret_key_here
ALPACA_LIVE_API_KEY=your_live_api_key_here
ALPACA_LIVE_SECRET_KEY=your_live_secret_key_here

# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── News / Sentiment ───────────────────────────────────────────────────────────
NEWS_API_KEY=your_newsapi_key_here           # https://newsapi.org
ALPHA_VANTAGE_KEY=your_alphavantage_key_here # macro + fundamentals

# ── Trading Config ─────────────────────────────────────────────────────────────
PAPER_CAPITAL=100000        # starting paper capital in USD
LIVE_CAPITAL=10000          # starting live capital in USD
MAX_POSITION_SIZE_PCT=0.05  # max 5% of portfolio in one position
MAX_DAILY_LOSS_PCT=0.03     # halt trading if daily loss > 3%
MAX_SECTOR_EXPOSURE=0.35    # max 35% in any one sector
CYCLE_INTERVAL_SECONDS=300  # 5-minute cycles

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./trading.db

# ── App ────────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development     # development | production
